@page
@model BPCalculator.Pages.BloodPressureModel

@{
    ViewData["Title"] = "BP Category Calculator";
}


<h4>BP Category Calculator</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" id="form1">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="BP.Systolic" class="control-label"></label>
                <input asp-for="BP.Systolic" class="form-control"/>
                <span asp-validation-for="BP.Systolic" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BP.Diastolic" class="control-label"></label>
                <input asp-for="BP.Diastolic" class="form-control" />
                <span asp-validation-for="BP.Diastolic" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Submit" class="btn btn-default" />
            </div>
            @if (Model.ShowResult && ViewData.ModelState.IsValid)
            {
                <div class="form-group">
                    <span data-testid="bp-category">@Html.DisplayFor(model => model.BP.Category)</span>
                </div>
                <div class="form-group">
                    <label class="control-label">Mean Arterial Pressure</label>
                    <span data-testid="map-value" class="form-control">@Model.BP.MeanArterialPressure mmHg</span>
                    <span data-testid="map-category">@Html.DisplayFor(model => model.BP.MeanArterialPressureCategory)</span>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
